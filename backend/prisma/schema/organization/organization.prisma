model Organization {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name String @unique(map: "organizations_name_unique") @db.VarChar(150)
  code String @unique(map: "organizations_code_unique") @db.VarChar(20)

  description String? @db.Text

  logo    String?
  website String?
  email   String?
  phone   String?
  address String?            @db.Text
  status  OrganizationStatus @default(ACTIVE)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  roles                  Role[]
  userRoles              UserRole[]
  sessions               Session[]
  students               Student[]
  studentEnrollments     StudentEnrollment[]
  studentNotifications   StudentNotification[]
  subjects               Subject[]
  topics                 Topic[]
  questions              Question[]
  questionComprehensions QuestionComprehension[]
  examTemplates          ExamTemplate[]
  exams                  Exam[]
  examImportJobs         ExamImportJob[]
  registrationPages      OrganizationRegistrationPage[]
  educationOptions       OrganizationEducationOption[]
  digitalLibraryLocations OrganizationDigitalLibraryLocation[]

  @@map("organizations")
}
