model StudentLandingCard {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  organizationId Int                    @map("organization_id")
  type           StudentLandingCardType @default(CUSTOM)
  systemKey      String?                @map("system_key") @db.VarChar(30)
  title          String                 @db.VarChar(120)
  description    String                 @db.VarChar(500)
  ctaLabel       String                 @map("cta_label") @db.VarChar(80)
  destinationUrl String                 @map("destination_url") @db.VarChar(1000)
  imageUrl       String?                @map("image_url") @db.VarChar(1000)
  imageAlt       String?                @map("image_alt") @db.VarChar(200)
  openInNewTab   Boolean                @default(true) @map("open_in_new_tab")
  displayOrder   Int                    @default(0) @map("display_order")
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityEvents StudentActivityEvent[]

  @@unique([organizationId, systemKey], map: "student_landing_cards_org_system_unique")
  @@index([organizationId, isActive, deletedAt, displayOrder], map: "student_landing_cards_org_active_order_idx")
  @@map("student_landing_cards")
}
