model Folder {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  sessionCourseId Int  @map("session_course_id")
  parentFolderId  Int? @map("parent_folder_id")

  name        String  @db.VarChar(150)
  description String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  icon        String? @db.VarChar(100)
  color       String? @db.VarChar(30)

  status   FolderStatus @default(ACTIVE)
  isActive Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessionCourse SessionCourse @relation(fields: [sessionCourseId], references: [id], onDelete: Cascade)
  parentFolder  Folder?       @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children      Folder[]      @relation("FolderHierarchy")
  resources     Resource[]

  @@unique([parentFolderId, sessionCourseId, name], map: "folders_parent_folder_id_session_course_id_name_unique")
  @@index([sessionCourseId], map: "folders_session_course_id_idx")
  @@index([parentFolderId], map: "folders_parent_folder_id_idx")
  @@index([status], map: "folders_status_idx")
  @@map("folders")
}
