model Student {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  userId         Int  @unique(map: "students_user_id_unique") @map("user_id")
  organizationId Int? @map("organization_id")

  studentCode     String  @unique(map: "students_student_code_unique") @map("student_code") @db.VarChar(50)
  admissionNumber String? @unique(map: "students_admission_number_unique") @map("admission_number") @db.VarChar(50)
  rollNumber      String? @map("roll_number") @db.VarChar(50)

  status   StudentStatus @default(ACTIVE)
  isActive Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  profile        StudentProfile?
  enrollments    StudentEnrollment[]
  courseProgress StudentCourseProgress[]
  videoProgress  StudentVideoProgress[]
  notifications  StudentNotification[]

  @@unique([organizationId, rollNumber], map: "students_organization_id_roll_number_unique")
  @@index([organizationId], map: "students_organization_id_idx")
  @@index([status, isActive], map: "students_status_is_active_idx")
  @@map("students")
}

model StudentProfile {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  studentId Int @unique(map: "student_profiles_student_id_unique") @map("student_id")

  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)

  dateOfBirth DateTime? @map("date_of_birth")
  gender      String?   @db.VarChar(30)

  phone          String? @db.VarChar(30)
  alternatePhone String? @map("alternate_phone") @db.VarChar(30)

  address    String? @db.Text
  city       String? @db.VarChar(100)
  state      String? @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(20)
  avatar     String?

  guardianName          String? @map("guardian_name") @db.VarChar(150)
  guardianPhone         String? @map("guardian_phone") @db.VarChar(30)
  emergencyContactName  String? @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentEnrollment {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  studentId      Int @map("student_id")
  organizationId Int @map("organization_id")
  sessionId      Int @map("session_id")

  status   StudentEnrollmentStatus @default(ACTIVE)
  isActive Boolean                 @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  courseEnrollments StudentCourseEnrollment[]

  @@unique([studentId, sessionId], map: "student_enrollments_student_id_session_id_unique")
  @@index([organizationId], map: "student_enrollments_organization_id_idx")
  @@index([sessionId], map: "student_enrollments_session_id_idx")
  @@index([status, isActive], map: "student_enrollments_status_is_active_idx")
  @@map("student_enrollments")
}

model StudentCourseEnrollment {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  enrollmentId    Int @map("enrollment_id")
  sessionCourseId Int @map("session_course_id")

  status   StudentCourseEnrollmentStatus @default(ACTIVE)
  isActive Boolean                       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionCourse SessionCourse     @relation(fields: [sessionCourseId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, sessionCourseId], map: "student_course_enrollment_unique")
  @@index([sessionCourseId], map: "student_course_enrollments_session_course_id_idx")
  @@index([status, isActive], map: "student_course_enrollments_status_is_active_idx")
  @@map("student_course_enrollments")
}

model CourseInstructor {
  id Int @id @default(autoincrement())

  sessionCourseId Int @map("session_course_id")
  instructorId    Int @map("instructor_id")

  createdAt DateTime @default(now()) @map("created_at")

  sessionCourse SessionCourse @relation(fields: [sessionCourseId], references: [id], onDelete: Cascade)
  instructor    User          @relation("CourseInstructors", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([sessionCourseId, instructorId], map: "course_instructors_session_course_id_instructor_id_unique")
  @@index([instructorId], map: "course_instructors_instructor_id_idx")
  @@map("course_instructors")
}

model StudentCourseProgress {
  id Int @id @default(autoincrement())

  studentId              Int  @map("student_id")
  sessionCourseId        Int  @map("session_course_id")
  completionPercentage   Int  @default(0) @map("completion_percentage")
  lastAccessedResourceId Int? @map("last_accessed_resource_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student              Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionCourse        SessionCourse @relation(fields: [sessionCourseId], references: [id], onDelete: Cascade)
  lastAccessedResource Resource?     @relation("LastAccessedResource", fields: [lastAccessedResourceId], references: [id], onDelete: SetNull)

  @@unique([studentId, sessionCourseId], map: "student_course_progress_student_id_session_course_id_unique")
  @@index([sessionCourseId], map: "student_course_progress_session_course_id_idx")
  @@index([lastAccessedResourceId], map: "student_course_progress_last_accessed_resource_id_idx")
  @@map("student_course_progress")
}

model StudentVideoProgress {
  id Int @id @default(autoincrement())

  studentId  Int @map("student_id")
  resourceId Int @map("resource_id")

  currentPositionSeconds Int       @default(0) @map("current_position_seconds")
  watchedPercentage      Int       @default(0) @map("watched_percentage")
  completedAt            DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId], map: "student_video_progress_student_id_resource_id_unique")
  @@index([resourceId], map: "student_video_progress_resource_id_idx")
  @@map("student_video_progress")
}

model StudentNotification {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  studentId      Int @map("student_id")
  organizationId Int @map("organization_id")

  type            StudentNotificationType
  title           String                  @db.VarChar(180)
  description     String                  @db.Text
  relatedEntity   String?                 @map("related_entity") @db.VarChar(80)
  relatedEntityId Int?                    @map("related_entity_id")
  isRead          Boolean                 @default(false) @map("is_read")
  expiresAt       DateTime?               @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead], map: "student_notifications_student_id_is_read_idx")
  @@index([organizationId, type], map: "student_notifications_organization_id_type_idx")
  @@index([createdAt], map: "student_notifications_created_at_idx")
  @@map("student_notifications")
}
