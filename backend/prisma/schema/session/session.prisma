model Session {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  organizationId Int @map("organization_id")

  name        String  @db.VarChar(150)
  code        String? @db.VarChar(20)
  description String? @db.Text

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  status   SessionStatus @default(UPCOMING)
  isActive Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionCourses SessionCourse[]

  @@unique([organizationId, name], map: "sessions_organization_id_name_unique")
  @@index([organizationId], map: "sessions_organization_id_idx")
  @@index([status], map: "sessions_status_idx")
  @@index([isActive], map: "sessions_is_active_idx")
  @@index([organizationId, status], map: "sessions_organization_id_status_idx")
  @@map("sessions")
}
