model Students {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt

  name        String   @db.VarChar(255)
  className   String   @map("class") @db.VarChar(255)
  gender      StudentGender
  status      Boolean  @default(true)

  email       String?  @unique(map: "students_email_unique") @db.VarChar(255)
  mobile      String?  @unique(map: "students_mobile_unique") @db.VarChar(255)
  password    String?  @db.VarChar(255)

  firstName   String?  @map("first_name") @db.VarChar(255)
  lastName    String?  @map("last_name") @db.VarChar(255)

  role        StudentRole @default(STUDENT)
  authStatus  StudentStatus @default(ACTIVE) @map("auth_status")

  isActive    Boolean  @default(true) @map("is_active")
  isVerified  Boolean  @default(false) @map("is_verified")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  profile     StudentProfile?
  refreshTokens RefreshToken[]
  cardActivities LegacyCardActivity[]
  activities     LegacyStudentActivity[]
  domains        LegacyStudentDomain[]
  sessions       LegacyStudentSession[]

  @@map("students")
}
