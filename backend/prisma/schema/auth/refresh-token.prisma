model RefreshToken {
  id Int @id @default(autoincrement())

  studentId BigInt @db.UnsignedBigInt

  token String @unique

  expiresAt DateTime

  status RefreshTokenStatus @default(ACTIVE)

  student Students @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("RefreshToken")
}
