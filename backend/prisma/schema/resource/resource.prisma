model Resource {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  folderId Int @map("folder_id")

  title       String       @db.VarChar(200)
  description String?      @db.Text
  type        ResourceType

  documentUrl     String? @map("document_url")
  videoUrl        String? @map("video_url")
  examId          Int?    @map("exam_id")
  thumbnail       String?
  mimeType        String? @map("mime_type") @db.VarChar(150)
  fileSize        BigInt? @map("file_size")
  durationInSeconds Int?  @map("duration_in_seconds")

  sortOrder      Int            @default(0) @map("sort_order")
  status         ResourceStatus @default(DRAFT)
  isPublished    Boolean        @default(false) @map("is_published")
  isDownloadable Boolean        @default(true) @map("is_downloadable")
  isActive       Boolean        @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId], map: "resources_folder_id_idx")
  @@index([type], map: "resources_type_idx")
  @@index([status], map: "resources_status_idx")
  @@index([isPublished], map: "resources_is_published_idx")
  @@map("resources")
}
