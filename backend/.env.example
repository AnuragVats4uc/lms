# Local development
NODE_ENV=development
PORT=5000
DATABASE_URL=mysql://lms_user:replace_me@localhost:3306/lms
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# Generate unique production secrets; never reuse these placeholders.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Enable on exactly one backend instance when the service is horizontally scaled.
ACTIVITY_RETENTION_WORKER_ENABLED=true

# Managed file storage. Keep all Utho credentials on the backend only.
STORAGE_PROVIDER=utho_s3
UTHO_S3_ENDPOINT=https://your-zone.utho.io
UTHO_S3_REGION=your-region
UTHO_S3_BUCKET=your-private-bucket
UTHO_S3_ACCESS_KEY=replace_with_utho_object_storage_access_key
UTHO_S3_SECRET_KEY=replace_with_utho_object_storage_secret_key
UTHO_S3_FORCE_PATH_STYLE=true
UTHO_S3_MAX_UPLOAD_BYTES=26214400

# Demo deployment example, set in Render rather than committing real values:
# DATABASE_URL=mysql://avnadmin:PERCENT_ENCODED_PASSWORD@AIVEN_HOST:AIVEN_PORT/lms_demo?sslcert=/etc/secrets/aiven-ca.pem&sslaccept=strict&connection_limit=5
# FRONTEND_URL=https://your-vercel-project.vercel.app
# PUBLIC_API_URL=https://your-render-service.onrender.com
