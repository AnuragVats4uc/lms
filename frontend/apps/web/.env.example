# Next.js exposes NEXT_PUBLIC_* values to the browser at build time.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Vercel production example:
# NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com/api/v1

# Organization/session registration slug used by /register (server only).
DEFAULT_REGISTRATION_SLUG=student-registration
